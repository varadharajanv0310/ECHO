{
  "name": "echo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A social platform where content belongs to a place, travels only when a person carries it, and dies if nobody does. Frontend only: React, TypeScript, three.js and WebGL, with no backend and no data collection.",
  "keywords": [
    "react",
    "typescript",
    "three.js",
    "webgl",
    "vite",
    "social-network",
    "glsl",
    "shaders",
    "zustand",
    "accessibility",
    "frontend-odyssey"
  ],
  "author": "V Varadharajan <varadharajanv09@gmail.com>",
  "license": "MIT",
  "homepage": "https://varadharajanv0310.github.io/ECHO/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/varadharajanv0310/ECHO.git"
  },
  "bugs": {
    "url": "https://github.com/varadharajanv0310/ECHO/issues"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@react-three/fiber": "^9.7.0",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "leva": "^0.10.1",
    "oxlint": "^1.82.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-glsl": "^1.6.1",
    "vitest": "^5.0.0"
  }
}
